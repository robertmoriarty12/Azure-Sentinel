{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/Azure-Sentinel/blob/master/Tools/Sentinel-Content-Forge-Accelerator/schemas/validation-report.schema.json",
  "title": "Sentinel Content Forge validation report",
  "description": "Structured validation results for content generated by the accelerator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "overallStatus",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "overallStatus": {
      "enum": [
        "passed",
        "passedWithWarnings",
        "failed",
        "needsReview"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactsChecked",
        "passedChecks",
        "warningChecks",
        "failedChecks",
        "notRunChecks"
      ],
      "properties": {
        "artifactsChecked": {
          "type": "integer",
          "minimum": 0
        },
        "passedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "warningChecks": {
          "type": "integer",
          "minimum": 0
        },
        "failedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "notRunChecks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "contentType",
          "status",
          "checks"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contentType": {
            "enum": [
              "analyticRule",
              "huntingQuery",
              "workbook"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "passedWithWarnings",
              "failed",
              "needsReview"
            ]
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "category",
                "status",
                "message"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*$"
                },
                "category": {
                  "enum": [
                    "structure",
                    "dependency",
                    "query",
                    "semantic",
                    "manualReview"
                  ]
                },
                "status": {
                  "enum": [
                    "passed",
                    "warning",
                    "failed",
                    "notRun"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}