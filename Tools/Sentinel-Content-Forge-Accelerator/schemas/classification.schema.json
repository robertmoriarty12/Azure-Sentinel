{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/Azure-Sentinel/blob/master/Tools/Sentinel-Content-Forge-Accelerator/schemas/classification.schema.json",
  "title": "Sentinel Content Forge classification",
  "description": "The agent's score-free category assignment for a submitted sample-data request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentRequestPath",
    "primaryCategory",
    "secondaryCategories",
    "rationale",
    "signals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentRequestPath": {
      "type": "string",
      "minLength": 1
    },
    "primaryCategory": {
      "type": "string",
      "minLength": 1
    },
    "secondaryCategories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "details"
        ],
        "properties": {
          "source": {
            "enum": [
              "sampleData",
              "connector",
              "dataSource",
              "fieldDescription",
              "securityScenario",
              "asimHint"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}