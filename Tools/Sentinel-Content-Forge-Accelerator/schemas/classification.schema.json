{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/Azure-Sentinel/blob/master/Tools/Sentinel-Content-Forge-Accelerator/schemas/classification.schema.json",
  "title": "Sentinel Content Forge classification",
  "description": "The agent's score-free ASIM schema compatibility assessment for submitted sample data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentRequestPath",
    "asimSchemas",
    "mappingStatus",
    "rationale",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contentRequestPath": {
      "type": "string",
      "minLength": 1
    },
    "asimSchemas": {
      "type": "array",
      "items": {
        "enum": [
          "AgentEvent",
          "AlertEvent",
          "AssetEntity",
          "AuditEvent",
          "Authentication",
          "DhcpEvent",
          "Dns",
          "FileEvent",
          "NetworkSession",
          "ProcessEvent",
          "RegistryEvent",
          "UserManagement",
          "WebSession"
        ]
      },
      "uniqueItems": true
    },
    "mappingStatus": {
      "enum": [
        "explicit",
        "compatible",
        "ambiguous",
        "unmapped",
        "notApplicable"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "details"
        ],
        "properties": {
          "source": {
            "enum": [
              "sampleData",
              "connector",
              "dataSource",
              "fieldDescription",
              "securityScenario",
              "asimHint",
              "localAsimParser",
              "officialProductDocumentation"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mappingStatus": {
            "enum": [
              "explicit",
              "compatible",
              "ambiguous"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "asimSchemas": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mappingStatus": {
            "enum": [
              "unmapped",
              "notApplicable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "asimSchemas": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}