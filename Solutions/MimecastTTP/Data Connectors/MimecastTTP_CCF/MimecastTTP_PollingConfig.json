        "startTimeAttributeName": "from",
        "endTimeAttributeName": "to",
        "queryWindowInMin": 15,
        "rateLimitQPS": 1,
        "isPostPayloadJson": true,
        "queryParametersTemplate": "{\"meta\":{\"pagination\":{\"pageSize\":500}},\"data\":[{\"from\":\"{_QueryWindowStartTime}\",\"to\":\"{_QueryWindowEndTime}\",\"oldestFirst\":true}]}",
        "headers": {
