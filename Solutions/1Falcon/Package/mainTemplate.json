{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "author": "Internal Test - support@microsoft.com",
    "comments": "Solution template for 1Falcon"
  },
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`.  We instead use the `workspace-location` which is derived from the LA workspace"
      }
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "resource group name where Microsoft Sentinel is setup"
      }
    },
    "subscription": {
      "type": "string",
      "defaultValue": "[last(split(subscription().id, '/'))]",
      "metadata": {
        "description": "subscription id where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "email": "support@microsoft.com",
    "_email": "[variables('email')]",
    "_solutionName": "1Falcon",
    "_solutionVersion": "3.0.0",
    "solutionId": "microsoftsentinelcommunity.azure-sentinel-solution-1falcon",
    "_solutionId": "[variables('solutionId')]",
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace'))]",
    "dataConnectorCCPVersion": "3.0.0",
    "_dataConnectorContentIdConnectorDefinition1": "1FalconConnector",
    "dataConnectorTemplateNameConnectorDefinition1": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnectorDefinition1')))]",
    "_dataConnectorContentIdConnections1": "1FalconConnectorConnections",
    "dataConnectorTemplateNameConnections1": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnections1')))]",
    "dataCollectionEndpoint1": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]",
    "blanks": "[replace('b', 'b', '')]",
    "_solutioncontentProductId": "[concat(take(variables('_solutionId'),50),'-','sl','-', uniqueString(concat(variables('_solutionId'),'-','Solution','-',variables('_solutionId'),'-', variables('_solutionVersion'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', variables('dataConnectorTemplateNameConnectorDefinition1'), variables('dataConnectorCCPVersion'))]",
      "location": "[parameters('workspace-location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "contentId": "[variables('_dataConnectorContentIdConnectorDefinition1')]",
        "displayName": "1Falcon CCF Checkpoint Test",
        "contentKind": "DataConnector",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('dataConnectorCCPVersion')]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition1'))]",
              "apiVersion": "2022-09-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
              "location": "[parameters('workspace-location')]",
              "kind": "Customizable",
              "properties": {
                "connectorUiConfig": {
                  "id": "1FalconConnector",
                  "title": "1Falcon CCF Checkpoint Test",
                  "publisher": "Internal",
                  "descriptionMarkdown": "The **1Falcon** connector is a throwaway test harness used to observe how the Codeless Connector Framework (CCF) computes query time boundaries and applies `initialCheckpointTimeUtc`. It defines two connections against a Mock REST Bin endpoint: one using a paired `_QueryWindowStartTime`/`_QueryWindowEndTime` query, and one using a single open-ended `since` start-time parameter. Point both at the same Mock REST Bin (different sub-paths) and inspect the bin's Request Monitor to see exactly what values CCF sends on the first poll and on subsequent polls.",
                  "graphQueriesTableName": "OneFalconPaired_CL",
                  "graphQueries": [
                    {
                      "metricName": "Paired window events ingested",
                      "legend": "OneFalconPaired_CL",
                      "baseQuery": "OneFalconPaired_CL"
                    },
                    {
                      "metricName": "Open ended events ingested",
                      "legend": "OneFalconOpenEnded_CL",
                      "baseQuery": "OneFalconOpenEnded_CL"
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "All paired-window test events",
                      "query": "OneFalconPaired_CL\n| sort by TimeGenerated desc"
                    },
                    {
                      "description": "All open-ended test events",
                      "query": "OneFalconOpenEnded_CL\n| sort by TimeGenerated desc"
                    }
                  ],
                  "dataTypes": [
                    {
                      "name": "OneFalconPaired_CL",
                      "lastDataReceivedQuery": "OneFalconPaired_CL\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "OneFalconOpenEnded_CL",
                      "lastDataReceivedQuery": "OneFalconOpenEnded_CL\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    }
                  ],
                  "connectivityCriteria": [
                    {
                      "type": "IsConnectedQuery",
                      "value": [
                        "union isfuzzy=true OneFalconPaired_CL, OneFalconOpenEnded_CL\n| summarize LastLogReceived = max(TimeGenerated)\n| project IsConnected = LastLogReceived > ago(1d)"
                      ]
                    }
                  ],
                  "permissions": {
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and write permissions on the Log Analytics workspace are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "write": true,
                          "read": true,
                          "delete": true
                        }
                      }
                    ],
                    "customs": [
                      {
                        "name": "Mock REST Bin",
                        "description": "Create a Mock REST Bin (mock-rest-bin.victorioussky-cbe548e7.eastus.azurecontainerapps.io) with response scenarios for the /paired and /openended paths before configuring this connector. Note the bin expires roughly an hour after creation, so create it right before you connect."
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "title": "STEP 1 - Create the Mock REST Bin",
                      "description": "Create a REST API Server bin at https://mock-rest-bin.victorioussky-cbe548e7.eastus.azurecontainerapps.io/ with two conditional response scenarios: one matching URL path `/paired`, one matching `/openended`. Both should check the `x-functions-key` header equals your chosen test key and return a 200 JSON body like `{\"events\": []}`. Note the bin's base endpoint URL, for example `https://mock-rest-bin.victorioussky-cbe548e7.eastus.azurecontainerapps.io/api/bins/<binId>`."
                    },
                    {
                      "title": "STEP 2 - Connect to the Mock REST Bin",
                      "description": "Enter the Mock REST Bin base URL and the test API key, then click **Connect**.",
                      "instructions": [
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Mock API Base URL",
                            "placeholder": "https://mock-rest-bin.victorioussky-cbe548e7.eastus.azurecontainerapps.io/api/bins/1falcon-backfill-vs-live-v2-c4a4f316",
                            "type": "text",
                            "name": "mockApiBaseUrl"
                          }
                        },
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "API Key",
                            "placeholder": "Enter your test API key",
                            "type": "password",
                            "name": "ApiKey"
                          }
                        },
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Backfill Start Time (UTC)",
                            "placeholder": "2026-08-04T00:00:00Z",
                            "type": "text",
                            "name": "backfillStartTime"
                          }
                        },
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Backfill End Time (UTC)",
                            "placeholder": "2026-08-05T00:00:00Z",
                            "type": "text",
                            "name": "backfillEndTime"
                          }
                        },
                        {
                          "type": "ConnectionToggleButton",
                          "parameters": {
                            "connectLabel": "connect",
                            "name": "connect"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', variables('_dataConnectorContentIdConnectorDefinition1')))]",
              "apiVersion": "2022-01-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "properties": {
                "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectorDefinitions', variables('_dataConnectorContentIdConnectorDefinition1'))]",
                "contentId": "[variables('_dataConnectorContentIdConnectorDefinition1')]",
                "kind": "DataConnector",
                "version": "[variables('dataConnectorCCPVersion')]",
                "source": {
                  "sourceId": "[variables('_solutionId')]",
                  "name": "[variables('_solutionName')]",
                  "kind": "Solution"
                },
                "author": {
                  "name": "Internal Test",
                  "email": "[variables('_email')]"
                },
                "support": {
                  "name": "Microsoft Corporation",
                  "email": "support@microsoft.com",
                  "tier": "Microsoft",
                  "link": "https://support.microsoft.com"
                },
                "dependencies": {
                  "criteria": [
                    {
                      "version": "[variables('dataConnectorCCPVersion')]",
                      "contentId": "[variables('_dataConnectorContentIdConnections1')]",
                      "kind": "ResourcesDataConnector"
                    }
                  ]
                }
              }
            },
            {
              "name": "1Falcon-DCR",
              "apiVersion": "2022-06-01",
              "type": "Microsoft.Insights/dataCollectionRules",
              "location": "[parameters('workspace-location')]",
              "kind": "[variables('blanks')]",
              "properties": {
                "dataCollectionEndpointId": "[variables('dataCollectionEndpoint1')]",
                "streamDeclarations": {
                  "Custom-OneFalconPaired_CL": {
                    "columns": [
                      {
                        "name": "TimeGenerated",
                        "type": "datetime"
                      },
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "message",
                        "type": "string"
                      }
                    ]
                  },
                  "Custom-OneFalconOpenEnded_CL": {
                    "columns": [
                      {
                        "name": "TimeGenerated",
                        "type": "datetime"
                      },
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "message",
                        "type": "string"
                      }
                    ]
                  }
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "workspaceResourceId": "[variables('workspaceResourceId')]",
                      "name": "sentinel-workspace"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Custom-OneFalconPaired_CL"
                    ],
                    "destinations": [
                      "sentinel-workspace"
                    ],
                    "transformKql": "source | extend TimeGenerated = now()",
                    "outputStream": "Custom-OneFalconPaired_CL"
                  },
                  {
                    "streams": [
                      "Custom-OneFalconOpenEnded_CL"
                    ],
                    "destinations": [
                      "sentinel-workspace"
                    ],
                    "transformKql": "source | extend TimeGenerated = now()",
                    "outputStream": "Custom-OneFalconOpenEnded_CL"
                  }
                ]
              }
            },
            {
              "name": "OneFalconPaired_CL",
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "retentionInDays": 90,
                "schema": {
                  "name": "OneFalconPaired_CL",
                  "description": "1Falcon CCF checkpoint test events, paired start/end query window connection.",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime",
                      "isDefaultDisplay": true
                    },
                    {
                      "name": "Id",
                      "type": "string",
                      "description": "Test event identifier returned by the mock API."
                    },
                    {
                      "name": "Message",
                      "type": "string",
                      "description": "Test event message returned by the mock API."
                    }
                  ]
                }
              }
            },
            {
              "name": "OneFalconOpenEnded_CL",
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "retentionInDays": 90,
                "schema": {
                  "name": "OneFalconOpenEnded_CL",
                  "description": "1Falcon CCF checkpoint test events, open-ended start-time-only query connection.",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime",
                      "isDefaultDisplay": true
                    },
                    {
                      "name": "Id",
                      "type": "string",
                      "description": "Test event identifier returned by the mock API."
                    },
                    {
                      "name": "Message",
                      "type": "string",
                      "description": "Test event message returned by the mock API."
                    }
                  ]
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "contentProductId": "[concat(take(variables('_solutionId'), 50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentIdConnectorDefinition1'),'-', variables('dataConnectorCCPVersion'))))]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "version": "[variables('dataConnectorCCPVersion')]"
      }
    },
    {
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition1'))]",
      "apiVersion": "2022-09-01-preview",
      "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
      "location": "[parameters('workspace-location')]",
      "kind": "Customizable",
      "properties": {
        "connectorUiConfig": {
          "id": "1FalconConnector",
          "title": "1Falcon CCF Checkpoint Test",
          "publisher": "Internal",
          "descriptionMarkdown": "The **1Falcon** connector is a throwaway test harness used to observe how the Codeless Connector Framework (CCF) computes query time boundaries and applies `initialCheckpointTimeUtc`. It defines two connections against a Mock REST Bin endpoint: one using a paired `_QueryWindowStartTime`/`_QueryWindowEndTime` query, and one using a single open-ended `since` start-time parameter. Point both at the same Mock REST Bin (different sub-paths) and inspect the bin's Request Monitor to see exactly what values CCF sends on the first poll and on subsequent polls.",
          "graphQueriesTableName": "OneFalconPaired_CL",
          "graphQueries": [
