                    },
                    {
                      "name": "Username",
                      "type": "string",
                      "description": "The username associated with the event."
                    },
                    {
                      "name": "FileSha256",
                      "type": "string",
                      "description": "The SHA-256 hash of the file."
                    },
                    {
                      "name": "AgentIsDecommissioned",
                      "type": "boolean",
                      "description": "Indicates whether the agent is decommissioned."
                    },
                    {
                      "name": "CollectionId",
                      "type": "string",
