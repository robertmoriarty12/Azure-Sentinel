                      "description": "Indicates by whom or what the action was initiated."
                    },
                    {
                      "name": "AgentNetworkStatus",
                      "type": "string",
                      "description": "The network status of the agent."
                    },
                    {
                      "name": "AgentComputerName",
                      "type": "string",
